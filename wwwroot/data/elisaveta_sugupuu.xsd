<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="inimene" type="InimeneType"/>
    <xs:complexType name="InimeneType">
        <xs:sequence>
            <xs:element name="nimi" type="xs:string"/>
            <xs:element name="lapsed" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element ref="inimene" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="synd" type="xs:gYear" use="required"/>
    </xs:complexType>
</xs:schema>

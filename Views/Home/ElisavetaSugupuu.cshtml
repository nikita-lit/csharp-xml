@using System.Xml.Xsl
@{
    ViewData["Title"] = "Elisaveta II Sugupuu";
    
    var wwwroot = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot/data");
 
    var xslt = new XslCompiledTransform();
    xslt.Load(System.IO.Path.Combine(wwwroot, "elisaveta_sugupuu_paring.xslt"));
    
    using var writer = new StringWriter();
    xslt.Transform(System.IO.Path.Combine(wwwroot, "elisaveta_sugupuu.xml"), null, writer);
}
<h1>@ViewData["Title"]</h1>
 
@Html.Raw(writer.ToString())
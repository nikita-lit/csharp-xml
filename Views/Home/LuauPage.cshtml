@model LuauModel

@{
    ViewData["Title"] = "Luau";
}
<h1>@ViewData["Title"]</h1>

<p>Luau</p>

<form asp-action="SubmitForm" method="post">
    <textarea asp-for="Code" class="form-control" rows="4"></textarea>
    
    <button type="submit" class="btn btn-primary mt-2">Execute</button>
</form>

@if (!string.IsNullOrEmpty(Model.Output))
{
    <div class="mt-4 p-3 bg-light border rounded">
        <h6>Output:</h6>
        <p style="white-space: pre-line;" class="text-success font-weight-bold">
            @Model.Output
        </p>
    </div>
}